.DS_Store
**/.DS_Store

# Release output
dist/

# Python environment and caches
python/venv/
**/__pycache__/
*.py[cod]

# Plugin runtime state and recognition evidence
var/*.sqlite3
var/*.sqlite3-*
var/backups/*
var/tmp/*
var/dumps/*
var/logs/*

# Preserve runtime directory structure
!var/backups/.gitkeep
!var/tmp/.gitkeep
!var/dumps/.gitkeep
!var/logs/.gitkeep
