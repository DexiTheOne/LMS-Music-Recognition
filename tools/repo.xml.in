<?xml version="1.0" encoding="UTF-8"?>
<extensions>
  <details>
    <title lang="EN">DexiTheOne LMS Plugins</title>
  </details>
  <plugins>
    <plugin name="ShazamCapture" version="@VERSION@" target="unix" minTarget="9.1.0" maxTarget="9.1.*">
      <title lang="EN">Shazam Capture</title>
      <desc lang="EN">Recognize music already being proxied by LMS without interrupting playback.</desc>
      <changes lang="EN">Moves the Docker Python environment outside the plugin install directory so LMS upgrades can replace every plugin file cleanly.</changes>
      <creator>DexiTheOne</creator>
      <category>information</category>
      <link>https://github.com/DexiTheOne/LMS-Music-Recognition</link>
      <icon>https://raw.githubusercontent.com/DexiTheOne/LMS-Music-Recognition/main/HTML/EN/plugins/ShazamCapture/html/images/shazamcapture.png</icon>
      <url>@ARCHIVE_URL@</url>
      <sha>@SHA1@</sha>
    </plugin>
  </plugins>
</extensions>
